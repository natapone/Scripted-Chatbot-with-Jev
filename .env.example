# Copy to .env at the repo root and fill in. .env is ignored by git and must never be committed.
# The server refuses to start without the key or without both rate lines.
OPENROUTER_API_KEY=
THB_PER_USD=
RATE_DATE=

# Rehearsal only — the owner's walk never sets these. JEV_HOST points the client at another
# address (a dead one, 127.0.0.1:1, rehearses "Jev unreachable"); JEV_TIMEOUT is seconds per call.
# JEV_HOST=openrouter.ai
# JEV_TIMEOUT=10

# Story 1.3 — rehearsal and tests only. SESSION_TTL_S: a session expires this many seconds after
# the last customer message (1800). SPEND_CAP_USD: this process's own spend, warm-ups included,
# after which turns answer "could not reach" without a call (0.50). VAR_DIR: where session
# snapshots go, `<VAR_DIR>/sessions/<id>.json` (the repo's `var/`, which git never publishes).
# SESSION_TTL_S=1800
# SPEND_CAP_USD=0.50
# VAR_DIR=var
