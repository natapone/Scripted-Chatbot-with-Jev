# Copy this file to .env and fill in the three values. Git never commits .env.
# The app does not start without them.

# Your OpenRouter API key.
OPENROUTER_API_KEY=
# The exchange rate used to show costs in baht, for example 33.17
THB_PER_USD=
# The date of that rate, for example 2026-09-23
RATE_DATE=

# Optional. The app stops calling the model after this many US dollars for each start.
# SPEND_CAP_USD=0.50
# Optional. The port to use (default 8765).
# PORT=8765

# For testing only — not needed to run the demo.
# JEV_HOST=openrouter.ai
# JEV_TIMEOUT=10
# SESSION_TTL_S=1800
# VAR_DIR=var
