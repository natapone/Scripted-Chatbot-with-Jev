# Deny by default — this is a PUBLIC repo. Nothing at the repo root is published unless it is
# allowlisted below. A new top-level file or folder must be added here on purpose.
# (Owner ruling: memory/source/2026-09-20_rulings.md)
/*

# --- allowlist ---
!/.gitignore
!/README.md
!/LICENSE
!/CLAUDE.md
!/tests/
!/app/
!/.env.example

# --- local only: the build's records, the prototype and the spikes (owner ruling 2026-09-23) ---
# Kept on disk for the agent and the owner; never staged, never pushed, never `git add -f`.
/memory/
/prototypes/
/spikes/

# --- never, even inside an allowlisted folder ---
/var/
.env
.env.*
!/.env.example
.envrc
*.key
*.pem
__pycache__/
*.py[codz]
.venv/
venv/
.DS_Store
*.log
